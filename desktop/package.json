{
  "name": "plania-desktop",
  "productName": "Plania",
  "version": "1.0.0",
  "description": "Plania · Planificación logística y comercial inteligente — aplicación de escritorio (Electron + React)",
  "main": "main.js",
  "author": "Plania",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "plotly.js-dist-min": "^2.35.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "uy.plania.desktop",
    "productName": "Plania",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/react/**",
      "node_modules/react-dom/**",
      "node_modules/plotly.js-dist-min/**",
      "node_modules/scheduler/**"
    ],
    "extraResources": [
      {
        "from": "../dist/Plania",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../assets/brand/plania.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plania",
      "uninstallDisplayName": "Plania",
      "license": false,
      "installerLanguages": [
        "es_ES"
      ]
    }
  }
}
